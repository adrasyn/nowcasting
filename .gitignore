# R pipeline cache — local-only, except for the vintage tracking CSV which is the
# persistent index of past nowcasts and must accumulate across CI runs.
/pipeline/.cache/*
!/pipeline/.cache/model_output/
/pipeline/.cache/model_output/*
!/pipeline/.cache/model_output/vintages/
/pipeline/.cache/model_output/vintages/*
!/pipeline/.cache/model_output/vintages/vintage_tracking.csv
/pipeline/renv/library/
/pipeline/renv/staging/
/pipeline/.Rhistory
/pipeline/.RData

# local editor / agent / cache dirs (never track on the public repo)
/.obsidian/
/.claude/
/.cache/
__pycache__/
*.pyc
# local notes / pasted images
/Feedback*.md
/feedback*.md
/Pasted image*.png
# scratch working dir + experimental backtest outputs (regenerable binaries)
/nowcast_new_scrape_results/
/pipeline/experimental/
# scratch render from the NAB parser
/nowcasting_v2/nab_t1.png
# local RDS snapshots for pipeline/tests/test_emit_json.R (regenerable from a run)
/pipeline/tests/fixtures/

# v3 (NY Fed port): the 21MB estimates blob, generated test fixtures, venv
/nowcasting_v3/nyfed_matlab/Estimates_*.mat
/nowcasting_v3/tests/fixtures/
/nowcasting_v3/.venv/
/nowcasting_v3/**/__pycache__/
# v3: build artifacts and Octave scratch output (regenerate with tools/gen_fixtures.m)
/nowcasting_v3/*.egg-info/
/nowcasting_v3/tools/fixtures_mat/
/nowcasting_v3/tools/probe_out.mat
